<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Exclude the Room database. It holds pending match stats that are
        waiting to sync to Firebase. Restoring them on another device would
        cause duplicate writes to Firestore.
    -->
    <exclude domain="database" path="kourt.db"/>
    <exclude domain="database" path="kourt.db-shm"/>
    <exclude domain="database" path="kourt.db-wal"/>
</full-backup-content>
